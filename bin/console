#!/usr/bin/env ruby
# frozen_string_literal: true

# Debug console for easy_ai
# Usage: bin/console

require "bundler/setup"
require "irb"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "easy_ai"

puts "EasyAI Debug Console"
puts "=" * 50
puts "EasyAI::Decision: ChoiceModel, Trainer, Predictor"
puts "EasyAI::Tokenizers: ByteBpe, NativeBpe, Registry"
puts 'tokenizer = EasyAI::Tokenizers::ByteBpe.new'
puts 'tokenizer.train(["你好，世界"], vocab_size: 512)'
puts 'tokenizer.encode("你好")'
puts "Teaching code: see learning/README.md (EasyAILearning)."
puts "Press Ctrl+D or type 'exit' to quit"
puts "=" * 50

# Configure IRB
IRB.start(__FILE__)
